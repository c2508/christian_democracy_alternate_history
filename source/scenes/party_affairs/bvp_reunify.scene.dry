title: Reunification with the BVP
new-page: true
view-if: ((z_party_leader = "Joos" and chud_joos = 1) or (z_party_leader = "Stegerwald" and non_cvp_stegerwald = 1 ) or z_party_leader = "Kaas") and bvp_reunify_timer = 0
on-arrival: month_actions += 1; bvp_reunify_timer += 5
