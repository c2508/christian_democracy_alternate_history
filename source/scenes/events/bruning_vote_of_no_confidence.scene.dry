[? if csvd_formed and not csvd_bruning_support : {!<tr><td>!} <span style="color: #8ED8E4;">**CSVD**</span>: {!</td><td>!} [+ csvd_r +] % {!</td><td>!} [+ csvd_seats +] {!</td><td>!} <span style="color: #9370DB;">Receptive</span> {!</td></tr>!} ?]

[? if kvp_formed and not kvp_bruning_support : {!<tr><td>!} <span style="color: #455B95;">**KVP**</span>: {!</td><td>!} [+ kvp_r +]% {!</td><td>!} [+ kvp_seats +] {!</td><td>!} <span style="color: #9370DB;">Receptive</span> {!</td></tr>!} ?]

