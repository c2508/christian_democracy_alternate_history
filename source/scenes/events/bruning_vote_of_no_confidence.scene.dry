{!<tr><td>!} <span style="color: #69A2BE;">**BVP**</span>: {!</td><td>!} 3% {!</td><td>!} 15 {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!}

[? if ddp_bruning_support : {!<tr><td>!} <span style="color: #D3C24D;">**[+ ddp_name +]**</span>: {!</td><td>!} [+ ddp_r +]% {!</td><td>!} [+ ddp_seats +] {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!} ?]

[? if dvp_bruning_support : {!<tr><td>!} <span style="color: #C0A054;">**DVP**</span>: {!</td><td>!} [+ dvp_r +]% {!</td><td>!} [+ dvp_seats +] {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!} ?]
 
[? if wp_bruning_support : {!<tr><td>!} <span style="color: #B8996F;">**WP**</span>: {!</td><td>!} [+ wp_r +]% {!</td><td>!} [+ wp_seats +] {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!} ?]

[? if cnblp_bruning_support : {!<tr><td>!} <span style="color: #006400;">**CNBLP**</span>: {!</td><td>!} [+ cnblp_r +] % {!</td><td>!} [+ cnblp_seats +] {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!} ?]

