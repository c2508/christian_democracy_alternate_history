[? if spd_bruning_support : {!<tr><td>!} <span style="color: #c00000;">**SPD**</span>: {!</td><td>!} [+ spd_r +]% {!</td><td>!} [+ spd_seats +] {!</td><td>!} <span style="color: #cE6A817;">Toleration</span> {!</td></tr>!} ?]

[? if not spd_bruning_support : {!<tr><td>!} <span style="color: #c00000;">**SPD**</span>: {!</td><td>!} [+ spd_r +]% {!</td><td>!} [+ spd_seats +] {!</td><td>!} <span style="color: #9370DB;">Receptive</span> {!</td></tr>!} ?]

[? if not ddp_bruning_support : {!<tr><td>!} <span style="color: #D3C24D;">**[+ ddp_name +]**</span>: {!</td><td>!} [+ ddp_r +]% {!</td><td>!} [+ ddp_seats +] {!</td><td>!} <span style="color: #9370DB;">Receptive</span> {!</td></tr>!} ?]

