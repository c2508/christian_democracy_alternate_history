[? if kvp_bruning_support and kvp_formed : {!<tr><td>!} <span style="color: #455B95;">**KVP**</span>: {!</td><td>!} [+ kvp_r +]% {!</td><td>!} [+ kvp_seats +] {!</td><td>!} <span style="color: #2E8B57;">Governing</span>{!</td></tr>!} ?]

