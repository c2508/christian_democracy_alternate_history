title: Vote of No-Confidence
subtitle: Bruning's government faces its first test
new-page: true
view-if: year = 1928 and month = 4 or bruning_vonc = 0 or chancellor = "Bruning" 
tags: event
max-visits: 1
on-arrival: {! 
Q.z_r = Math.round(Q.z_r*10.0)/10.0;
(Q.bruning_support = Q.z_seats + Q.bvp_seats);
(Q.bruning_opposed = Q.kpd_seats + Q.nsdap_seats);
(Q.bruning_undecided = Q.spd_seats + Q.ddp_seats + Q.dvp_seats + Q.wp_seats + Q.cnblp_seats + Q.dnvp_seats);
(Q.bruning_support_percentage = Math.round(Q.z_r*10.0)/10.0);
(Q.bruning_opposed_percentage = Math.round((Q.kpd_r + Q.nsdap_r)*10.0)/10.0);
(Q.bruning_undecided_percentage = Math.round((Q.spd_r + Q.ddp_r + Q.dvp_r + Q.wp_r + Q.cnblp_r + Q.dnvp_r)*10.0)/10.0);
if (Q.csvd_formed >= 1) {
    Q.bruning_undecided += Q.csvd_seats;
    Q.bruning_undecided_percentage += Q.csvd_r;
}
if (Q.kvp_formed >= 1) {
    Q.bruning_undecided += Q.kvp_seats;
    Q.bruning_undecided_percentage += Q.kvp_r;
}
!}
go-to: convince

@convince
on-arrival: {!
Q.bruning_support_percentage = Math.round(Q.bruning_support_percentage * 10) / 10;
Q.bruning_undecided_percentage = Math.round(Q.bruning_undecided_percentage * 10) / 10;
Q.bruning_opposed_percentage = Math.round(Q.bruning_opposed_percentage * 10) / 10;
!}
on-display: {!
data = [
    {
        "id": "kpd",
        "legend": "KPD",
        "name": "KPD",
        "seats": Q.kpd_seats,
    }
];
if (Q.sapd_formed && Q.sapd_r) {
    data.push({
            "id": "sapd",
            "legend": "SAPD",
            "name": "SAPD",
            "seats": Q.sapd_seats,
            });
}
data = data.concat([
    {
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Q.spd_seats,
    },
    {
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Q.ddp_seats,
    },
    {
        "id": "z",
        "legend": "Center",
        "name": "Center",
        "seats": Q.z_seats,
    },
    {
        "id": "bvp",
        "legend": "BVP",
        "name": "BVP",
        "seats": Q.bvp_seats,
    },
    {
        "id": "dvp",
        "legend": "DVP",
        "name": "DVP",
        "seats": Q.dvp_seats,
    },
  {
        "id": "wp",
        "legend": "WP",
        "name": "WP",
        "seats": Q.wp_seats,
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Q.other_seats,
    },
   {
        "id": "cnblp",
        "legend": "CNBLP",
        "name": "CNBLP",
        "seats": Q.cnblp_seats,
    },
]);

if (Q.csvd_formed && Q.csvd_r) {
    data.push({
        "id": "csvd",
        "legend": "CSVD",
        "name": "CSVD",
        "seats": Q.csvd_seats,
    });
}

if (Q.kvp_formed && Q.kvp_r) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Q.kvp_seats,
    });
}

data = data.concat([
    {
        "id": "dnvp",
        "legend": "DNVP",
        "name": "DNVP",
        "seats": Q.dnvp_seats,
    },
    {
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Q.nsdap_seats,
    },
]);

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}

if (Q.spd_bruning_support == 1) {
  document.body.classList.add("highlight-spd");
} else {
  document.body.classList.remove("highlight-spd");
}
!}

= Bruning's Mandate

Following the Great Depression, Germany's finances have been in shambles, with most of the Landers running huge deficits every year. As such, Bruning has been tasked with balancing the budget through a ruthless austerity program, for which he requires the support of the Reichstag. However, <span style="color: #808080;">Hindenburg's</span> aversion towards <span style="color: #c00000;">socialist</span> governance and the <span style="color: #3E88B3;">**DNVP's**</span> vacillating stance mean that Bruning has to rely on the support of the parties of the middle.
Composed primarily of <span style="color: #909090;">**special interest**</span> parties, their single-minded pursuit of <span style="color: #909090;">**special interests**</span> might jeopardise Bruning's goal of balancing the budget, making their support tenuous at best. Now, our task in the Reichstag is to somehow wrangle a majority in favour of Bruning's policies. 

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

