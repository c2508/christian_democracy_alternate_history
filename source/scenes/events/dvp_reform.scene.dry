subtitle: The <span style="color: #C0A054;">**DVP**</span> decides their future...
view-if: year = 1928 and month = 12 and not lvp_formed and lvp_timer_trigger == 0 
priority: 2
on-arrival: {!

if (Q.dvp_relation >= 75) {
    Q.dvp_left += 0.5;
} else if (Q.dvp_relation < 50) {
    Q.dvp_right += 0.5;
}
if (!Q.in_grand_coalition) {
    Q.dvp_right += 1;
}
if (Q.spd_relation >= 65) {
    Q.dvp_right += 0.5;
} else if (Q.spd_relation < 35) {
    Q.dvp_left += 0.5;
}
if (Q.left_strength > 25) {
    Q.dvp_right += 0.5;
}
if (Q.foreign_minister_party = 'DVP' && Q.in_grand_coalition) {
    Q.dvp_left += 1; 
}
if (Q.new_middle_dvp + Q.new_middle_dnvp + Q.new_middle_z < 50) {
    Q.dvp_left += 1; 
}
if (Q.prussian_concordat = 1) {
    Q.dvp_right += 1;
}
if (Q.dvp_right > (Q.dvp_left*1.5) || (Q.dvp_right > (Q.dvp_left + 4))) {
    Q.dvp_ideology = "Right"
} else if (Q.dvp_left > (Q.dvp_right*1.5) || (Q.dvp_left > (Q.dvp_right + 4))) {
    Q.dvp_ideology = "Left"
} else {
    Q.dvp_ideology = "Moderate"
}

if (Q.dvp_ideology == "Left" || (Q.dvp_left - Q.dvp_right >= 3)) {
    Q.reform_pass = 1;
}

if (!Q.reform_pass) {
    Q.reform_fail = 1;
}
!}
