on-arrival: {!

Q.cnva_formed = 1;
Q.parties.push('cnva');

Q.workers_cnva = 8;
Q.workers_nsdap -= 1; 
Q.workers_dnvp -= 4;
Q.workers_others -= 1;
Q.new_middle_cnva = 14; 
Q.new_middle_dnvp -= 5;
Q.new_middle_others -= 7;
Q.old_middle_csvd = 8;
Q.old_middle_dnvp -= 4;
Q.old_middle_others -= 1;
Q.old_middle_dvp -= 1; 
Q.rural_cnva = 11;
Q.rural_dnvp -= 4; 
Q.rural_cnblp -= 2;
Q.catholics_cnva = 6;
Q.unemployed_cnva = 5;
             
Q.cnva_r = 0;
Q.old_cnva_r = 0;
for (var record of Q.election_records) {
    record['cnva'] = 0;
}
for (var record of Q.party_support_records) {
    record['cnva'] = 0;
}
!}
